{
  "manifest_version": 3,
  "name": "PES Stats Converter Copy - By PES Indie Team",
  "version": "1.3.10",
  "description": "Button that will allow you to convert FIFA, FM and Efootball stats into old-gen PES stats.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.sofifa.com/*",
    "https://*.fminside.net/*",
    "https://*.pesmaster.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.sofifa.com/player/*",
        "*://*.sofifa.com/team/*",
        "*://*.fminside.net/players/*",
        "*://*.fminside.net/clubs/*",
        "*://*.pesmaster.com/*/efootball-2022/player/*",
        "*://*.pesmaster.com/*/efootball-2022/team/*"
      ],
      "run_at": "document_idle",
      "js": [
        "lib/enums.js",
        "data/source-labels.js",
        "lib/dom.js",
        "lib/logger.js",
        "lib/utils.js",
        "lib/positions.js",
        "lib/names.js",
        "lib/abilities.js",
        "lib/core.js",
        "converters/pes5.js",
        "converters/pes21.js",
        "converters/pes13.js",
        "data/nationalities.js",
        "data/pes21-stats-table.js",
        "lib/namespace.js"
      ]
    },
    {
      "matches": ["*://*.sofifa.com/player/*"],
      "run_at": "document_idle",
      "js": ["content/sources/sofifa.js", "content/bootstrap.js"]
    },
    {
      "matches": ["*://*.sofifa.com/team/*"],
      "run_at": "document_idle",
      "js": [
        "content/sources/sofifa.js",
        "content/sources/sofifa-team.js",
        "content/bootstrap.js"
      ]
    },
    {
      "matches": ["*://*.fminside.net/players/*"],
      "run_at": "document_idle",
      "js": ["content/sources/fminside.js", "content/bootstrap.js"]
    },
    {
      "matches": ["*://*.fminside.net/clubs/*"],
      "run_at": "document_idle",
      "js": [
        "content/sources/fminside.js",
        "content/sources/fminside-team.js",
        "content/bootstrap.js"
      ]
    },
    {
      "matches": ["*://*.pesmaster.com/*/efootball-2022/player/*"],
      "run_at": "document_idle",
      "js": ["content/sources/pesmaster.js", "content/bootstrap.js"]
    },
    {
      "matches": ["*://*.pesmaster.com/*/efootball-2022/team/*"],
      "run_at": "document_idle",
      "js": [
        "content/sources/pesmaster.js",
        "content/sources/pesmaster-team.js",
        "content/bootstrap.js"
      ]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/pes_indie_16.png",
      "48": "icons/pes_indie_48.png",
      "128": "icons/pes_indie_128.png"
    }
  },
  "icons": {
    "16": "icons/pes_indie_16.png",
    "48": "icons/pes_indie_48.png",
    "128": "icons/pes_indie_128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "pesstatscopy@pesindie.com",
      "strict_min_version": "109.0"
    }
  }
}
