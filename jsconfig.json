{
  "compilerOptions": {
    "target": "es2021",
    "module": "preserve",
    "checkJs": true,
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "lib": ["es2021", "dom", "dom.iterable"]
  },
  "include": ["src"],
  "exclude": ["test", "node_modules"]
}
